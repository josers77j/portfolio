---
import removeTrailingSlash from "@/utils/removeTrailingSlash";
import presentation from "@/data/presentation";
import i18next from "i18next";
import { initReactI18next } from 'react-i18next';
import LanguageSwitcher from './LanguageSwitcher';

const pathname = removeTrailingSlash(Astro.url.pathname);

i18next.use(initReactI18next).init({
  resources: {
    en: {
      translation: {
        "home": "Home",
        "contact": "Contact",
        "projects": "Projects",
        "about": "About"
      }
    },
    es: {
      translation: {
        "home": "Inicio",
        "contact": "Contacto",
        "projects": "Proyectos",
        "about": "Acerca de"
      }
    }
  },
  lng: "en",
  fallbackLng: "en",
  interpolation: {
    escapeValue: false
  }
});

---

<header class="z-40 flex w-full flex-col gap-4 md:flex-row md:items-center md:justify-between">
  <a href={`mailto:${presentation.mail}`} class="hover:text-neutral-100 text-sm">
    {presentation.mail}
  </a>

  <nav role="navigation">
    <ul role="list" class="flex flex-row gap-4">
      <li>
        <a
          href="/"
          class:list={{
            ["hover:text-neutral-100"]: true,
            ["text-neutral-100"]: pathname === "/",
          }}
        >
          {i18next.t('home')}
        </a>
      </li>
      <li>
        <a
          href="/projects"
          class:list={{
            ["hover:text-neutral-100"]: true,
            ["text-neutral-100"]: pathname === "/projects",
          }}
        >
          {i18next.t('projects')}
        </a>
      </li>
      <li>
        <a
          href="/contact"
          class:list={{
            ["hover:text-neutral-100"]: true,
            ["text-neutral-100"]: pathname === "/contact",
          }}
        >
          {i18next.t('contact')}
        </a>
      </li>
    </ul>
  </nav>

  <LanguageSwitcher client:load />
</header>
