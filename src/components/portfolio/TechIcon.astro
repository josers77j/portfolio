---
interface Props { name: string }
const { name } = Astro.props;
const icons: Record<string, string> = {
  TypeScript: "/icons/typescript/typescript-original.svg",
  "Node.js": "/icons/nodejs/nodejs-original.svg",
  NestJS: "/icons/nestjs/nestjs-original.svg",
  Angular: "/icons/angular/angular.svg",
  "ASP.NET Core": "/icons/c/dot-net-core.svg",
  PostgreSQL: "/icons/postgresql/postgresql-original.svg",
  "SQL Server": "/icons/microsoftsqlserver/microsoftsqlserver-plain.svg",
  MySQL: "/icons/mysql/mysql-original.svg",
  Prisma: "/icons/prisma/prisma-original.svg",
  Docker: "/icons/docker/docker-original.svg",
  AWS: "/icons/portfolio/aws.svg",
  Redis: "/icons/portfolio/redis.svg",
  Kubernetes: "/icons/kubernetes/kubernetes-original.svg",
  Jest: "/icons/jest/jest.svg",
  Playwright: "/icons/portfolio/playwright.svg",
  "Tailwind CSS": "/icons/portfolio/tailwindcss.svg",
  GCP: "/icons/portfolio/googlecloud.svg",
};
const src = icons[name];
const security = name === "JWT" || name === "RBAC";
---

<span class="tech-icon" aria-hidden="true">
  {src ? <img src={src} width="20" height="20" alt="" loading="lazy" /> : (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      {security ? <><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" /></> : name === "daisyUI" ? <><circle cx="12" cy="12" r="3" /><path d="M12 2v4m0 12v4M2 12h4m12 0h4M5 5l3 3m8 8 3 3M5 19l3-3m8-8 3-3" /></> : <><rect x="2" y="8" width="6" height="8" rx="1" /><rect x="16" y="8" width="6" height="8" rx="1" /><path d="M8 12h8m-6-3 3 3-3 3" /></>}
    </svg>
  )}
</span>
