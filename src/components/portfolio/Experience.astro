---
import { copy, type Locale } from "@/data/portfolio";
interface Props {
  locale: Locale;
}
const t = copy[Astro.props.locale];
const sections = [
  { id: "experiencia", title: t.experience, entries: t.jobs },
  { id: "comunidad", title: t.community, entries: t.communityContributions },
];
---

{sections.map((section) => (
  <section id={section.id} class="experience-full" aria-labelledby={`${section.id}-title`}>
    <h2 id={`${section.id}-title`}>{section.title}</h2>
    {section.id === "experiencia" && <p class="section-intro">{t.experienceIntro}</p>}
    <div class="experience-list">
      {section.entries.map((entry) => (
        <article class="panel job experience-entry" id={entry.id}>
          <header class="experience-heading">
            <h3>{entry.name}</h3>
            <span class="experience-date">{entry.date}</span>
          </header>
          <p class="experience-context">{entry.context}</p>
          <p><strong>{t.contribution}: </strong>{entry.text}</p>
          <details class="experience-technical">
            <summary>{t.technicalDetails}</summary>
            <p><strong>{t.technicalFocus}: </strong>{entry.learning}</p>
          </details>
        </article>
      ))}
    </div>
  </section>
))}
