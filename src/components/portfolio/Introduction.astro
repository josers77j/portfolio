---
import { copy, identity, type Locale } from "@/data/portfolio";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<section id="inicio" class="bento" aria-label={t.nav[0]}>
  <article class="panel hero">
    <h1>{t.headline}</h1>
    <p class="intro">{t.intro}</p>
    <div class="actions">
      <a class="button primary" href="#proyectos"
        >{t.viewProjects}<span aria-hidden="true">↗</span></a
      ><a class="button" href={`mailto:${identity.email}`}>{t.talk}</a>
    </div>
  </article>
  <article class="panel about" aria-labelledby="about-title">
    <h2 id="about-title">{t.about}</h2>
    {
      identity.photo ? (
        <img
          class="avatar"
          src={identity.photo}
          alt={identity.name}
          width="76"
          height="76"
        />
      ) : null
    }
    <p class="name" style="color:var(--text)">{identity.name}</p>
    <p class="location">⌖ {t.location}</p>
    <p class="bio">{t.bio}</p>
  </article>
  <article class="panel experience-summary" aria-labelledby="timeline-title">
    <div class="section-heading">
      <h2 id="timeline-title">{t.experience}</h2><a
        class="text-link"
        href="#experiencia">{t.trajectory} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="timeline">
      {
        t.timeline.map((item) => (
          <a class="milestone" href={`#${item.target}`} data-job={item.target}>
            <time>{item.date}</time>
            <>
              <strong>{item.label}</strong>
              <p>{item.summary}</p>
            </>
          </a>
        ))
      }
    </div>
  </article>
  <article class="panel contact" aria-labelledby="contact-title">
    <h2 id="contact-title">{t.contact}</h2>
    <p class="contact-prompt">
      <span class="contact-icon" aria-hidden="true">✉</span>{t.contactIntro}
    </p>
    <div class="socials">
      <a href={`mailto:${identity.email}`}>✉ &nbsp;{t.email}</a><a
        href={identity.linkedin}
        target="_blank"
        rel="noopener noreferrer">in &nbsp;LinkedIn ↗</a
      ><a href={identity.github} target="_blank" rel="noopener noreferrer"
        >⌘ &nbsp;GitHub ↗</a>
    </div>
  </article>
</section>
