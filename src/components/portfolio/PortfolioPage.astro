---
import Projects from '@/components/portfolio/Projects.astro';
import Stack from '@/components/portfolio/Stack.astro';
import Experience from '@/components/portfolio/Experience.astro';
import Introduction from '@/components/portfolio/Introduction.astro';
import PortfolioLayout from '@/layouts/PortfolioLayout.astro';
import type { Locale } from '@/data/portfolio';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<PortfolioLayout locale={locale}>
  <main id="main"><Introduction locale={locale} /><Stack locale={locale} /><Projects locale={locale} /><Experience locale={locale} /></main>
</PortfolioLayout>
