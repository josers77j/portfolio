---
import { projectCollections } from "@/data/constants";

type Props = {
  title: string;
  image: string;
  techs: string;
  description: string;
};

const { title, image, description, techs } = Astro.props;
---

<div
  class="group flex max-w-sm flex-col gap-2 rounded-md border-neutral-300 p-4 transition-all duration-300 hover:-translate-y-1 hover:border-neutral-400 w-full h-auto bg-white/10 backdrop-blur-lg"
>
  <img
    src={image}
    alt={title}
    class="w-full h-auto object-cover rounded transition-transform duration-300"
  />

  <div class="flex flex-col gap-2 flex-grow">
    <p class="text-xl text-neutral-100 font-semibold">{title}</p>
    <p class="text-neutral-400">{description}</p>
    <p class="text-neutral-500 text-sm">{techs}</p>
  </div>

  <!-- Botones al final del card -->
  <div class="flex gap-2 mt-auto pt-4">
    <a
      href="https://github.com/josers77j/Control-inventario-php"
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 flex items-center justify-center px-4 py-3 bg-gray-800 text-white font-bold rounded-lg shadow hover:bg-gray-700 transition"
    >
      Ver código
    </a>

    <a
      href="https://tu-demo-url.com"
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 flex items-center justify-center px-4 py-3 bg-blue-600 text-white font-bold rounded-lg shadow hover:bg-blue-500 transition"
    >
      Ver Demo
    </a>
  </div>
</div>
