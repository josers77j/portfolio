---
import { projectCollections } from "@/data/constants";
import Translate from "./Translate";
import i18n from "@/i18n";

type Props = {
  title?: string;
  titleKey?: string;
  image: string;
  techs?: string;
  techsKey?: string;
  description?: string;
  descriptionKey?: string;
  codeUrl?: string;
  demoUrl?: string;
  extraLinks?: { label: string; url: string }[];
  noteKey?: string;
};

const {
  title,
  titleKey,
  image,
  description,
  descriptionKey,
  techs,
  techsKey,
  codeUrl,
  demoUrl,
  extraLinks,
  noteKey,
} = Astro.props;

const titleText = titleKey ? i18n.t(titleKey) : title || '';
const descriptionText = descriptionKey ? i18n.t(descriptionKey) : description || '';
const techsText = techsKey ? i18n.t(techsKey) : techs || '';
const noteText = noteKey ? i18n.t(noteKey) : '';
// Format note HTML: convert explicit slashes or newlines to <br/> for better readability
const noteHtml = noteText
  ? noteText.replace(/\s?\/\s?/g, '<br/>').replace(/\n/g, '<br/>')
  : '';
---

<div
  class="group flex max-w-sm flex-col gap-2 rounded-md border-neutral-300 p-4 transition-all duration-300 hover:-translate-y-1 hover:border-neutral-400 w-full h-auto bg-white/10 backdrop-blur-lg"
>
  <img
    src={image}
    alt={title}
    class="w-full h-auto object-cover rounded transition-transform duration-300"
  />

    <div class="flex flex-col gap-2 flex-grow">
    <p class="text-xl text-neutral-100 font-semibold" data-i18n={titleKey}>{titleText}</p>
    <p class="text-neutral-400" data-i18n={descriptionKey}>{descriptionText}</p>
    <p class="text-neutral-500 text-sm" data-i18n={techsKey}>{techsText}</p>
  </div>

  {/* Extra links + note: placed above the action buttons for better UX */}
  {(extraLinks && extraLinks.length > 0) || noteText ? (
    <div class="mt-3 flex flex-col gap-3">
      {extraLinks && extraLinks.length > 0 ? (
        <div class="flex flex-wrap gap-2">
          {extraLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm text-neutral-200 bg-neutral-800/40 px-3 py-1 rounded-md border border-neutral-700 hover:bg-neutral-800/60 transition"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 010 5.656l-3.536 3.536a4 4 0 01-5.656-5.656l1.415-1.414" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.586 13.414a4 4 0 015.657-5.657l1.415 1.414a4 4 0 01-5.656 5.657" />
              </svg>
              {link.label}
            </a>
          ))}
        </div>
      ) : null}

      {noteText ? (
        <p class="text-sm text-neutral-300 italic bg-neutral-900/20 px-3 py-2 rounded-md flex items-start gap-2" data-i18n={noteKey} data-i18n-html>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-neutral-300 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10A8 8 0 11 2 10a8 8 0 0116 0zm-8-3a1 1 0 100 2 1 1 0 000-2zm1 6a1 1 0 10-2 0v1a1 1 0 002 0v-1z" clip-rule="evenodd" />
          </svg>
          <span set:html={noteHtml} />
        </p>
      ) : null}
    </div>
  ) : null}

  <!-- Botones al final del card -->
  <div class="flex gap-2 mt-auto pt-4">
    {codeUrl ? (
      <a
        href={codeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 flex items-center justify-center px-4 py-3 bg-gray-800 text-white font-bold rounded-lg shadow hover:bg-gray-700 transition"
      >
        <Translate k="viewCode" client:load />
      </a>
    ) : null}

    {demoUrl ? (
      <a
        href={demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-1 flex items-center justify-center px-4 py-3 bg-blue-600 text-white font-bold rounded-lg shadow hover:bg-blue-500 transition"
      >
        <Translate k="viewDemo" client:load />
      </a>
    ) : null}
  </div>
</div>
