---
// SidebarNav.astro
type NavItem = {
  id: string;
  label: string;
};

type Props = {
  items: NavItem[];
};

const { items } = Astro.props;
---

<nav class="fixed right-8 top-1/2 -translate-y-1/2 hidden lg:block z-50">
  <ul class="flex flex-col gap-6">
    {items.map((item) => (
      <li class="relative group">
        <a
          href={`#${item.id}`}
          data-section={item.id}
          class="nav-dot flex items-center gap-3 transition-all duration-300 flex-row-reverse"
        >
          <span class="w-3 h-3 rounded-full bg-neutral-400 border-2 border-neutral-400 transition-all duration-300 group-hover:bg-blue-400 group-hover:border-blue-400 group-hover:scale-125"></span>
          <span class="nav-label opacity-100 text-sm text-neutral-100 font-medium whitespace-nowrap transition-all duration-300 absolute right-6">
            {item.label}
          </span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-dot.active span:first-child {
    @apply bg-blue-400 border-blue-400 scale-125 shadow-lg shadow-blue-500/50;
  }

  .nav-dot.active .nav-label {
    @apply opacity-100 text-blue-300 font-semibold;
  }

  /* Efecto de sombra para mejor visibilidad */
  .nav-label {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);
  }
</style>

<script>
  // Detectar la sección visible y actualizar el indicador activo
  const observerOptions = {
    root: null,
    rootMargin: '-50% 0px -50% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        // Remover clase active de todos los dots
        document.querySelectorAll('.nav-dot').forEach((dot) => {
          dot.classList.remove('active');
        });

        // Agregar clase active al dot correspondiente
        const activeId = entry.target.id;
        const activeDot = document.querySelector(`.nav-dot[data-section="${activeId}"]`);
        if (activeDot) {
          activeDot.classList.add('active');
        }
      }
    });
  }, observerOptions);

  // Observar todas las secciones
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('article[id], section[id]');
    sections.forEach((section) => observer.observe(section));
  });

  // Scroll suave al hacer clic
  document.querySelectorAll('.nav-dot').forEach((dot) => {
    dot.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = dot.getAttribute('data-section');
      const targetSection = document.getElementById(targetId || '');

      if (targetSection) {
        targetSection.scrollIntoView({
          behavior: 'smooth',
          block: 'center'
        });
      }
    });
  });
</script>
