---
import type { Locale } from "@/data/portfolio";
import { copy } from "@/data/portfolio";
import "@/styles/portfolio.css";
import SectionNavigation from "@/components/portfolio/SectionNavigation.astro";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t.description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8fafc" />
    <link rel="icon" href="/favicon.svg" />
    <title>{t.title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem("portfolio-theme");
        document.documentElement.dataset.theme =
          theme === "dark" || theme === "light"
            ? theme
            : matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
      } catch {
        document.documentElement.dataset.theme = matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches
          ? "dark"
          : "light";
      }
    </script>
  </head>
  <body id="page-top">
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell">
      <header class="navbar">
        <a
          class="brand"
          href={locale === "es" ? "/" : "/en/"}
          aria-label="José Ruben Trejo">JT<span>.</span></a
        >
      </header>
      <SectionNavigation locale={locale} />
      <slot />
      <footer class="footer">
        <span>© {new Date().getFullYear()} José Ruben Trejo</span>
      </footer>
    </div>
    <a id="back-to-top" class="back-to-top" href="#page-top" hidden
      aria-label={locale === "es" ? "Volver al inicio" : "Back to top"}
      title={locale === "es" ? "Volver al inicio" : "Back to top"}>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 12 6-6 6 6M12 6v14" />
      </svg>
    </a>
    <style>
      .back-to-top {
        position: fixed;
        right: 28px;
        bottom: calc(24px + env(safe-area-inset-bottom, 0px));
        z-index: 50;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border: 1px solid var(--line);
        border-radius: 14px;
        color: var(--orange);
        background: var(--surface);
        backdrop-filter: blur(12px);
        box-shadow: var(--shadow);
      }
      .back-to-top[hidden] { display: none; }
      .back-to-top:hover { border-color: var(--orange); background: var(--soft); }
      @media (max-width: 640px) { .back-to-top { right: 16px; } }
    </style>
    <script>
      const backToTop = document.querySelector<HTMLAnchorElement>("#back-to-top");
      const updateBackToTop = () => {
        if (backToTop) backToTop.hidden = window.scrollY < 320;
      };
      window.addEventListener("scroll", updateBackToTop, { passive: true });
      window.addEventListener("load", updateBackToTop, { once: true });
      updateBackToTop();
      const button = document.querySelector<HTMLButtonElement>("#theme-toggle");
      const media = matchMedia("(prefers-color-scheme: dark)");
      const sync = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        button?.setAttribute("aria-checked", String(dark));
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", dark ? "#0b1220" : "#f8fafc");
      };
      sync();
      button?.addEventListener("click", () => {
        const theme =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem("portfolio-theme", theme);
        } catch {}
        sync();
      });
      media.addEventListener("change", (event) => {
        try {
          if (localStorage.getItem("portfolio-theme")) return;
        } catch {}
        document.documentElement.dataset.theme = event.matches
          ? "dark"
          : "light";
        sync();
      });
      document
        .querySelectorAll<HTMLAnchorElement>(".language-control a")
        .forEach((link) => {
          link.addEventListener("click", () => {
            link.hash = location.hash;
          });
        });
    </script>
  </body>
</html>
