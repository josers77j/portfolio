---
import Layout from "@/layouts/Layout.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import PostCard from "@/components/PostCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SidebarNavReact from "@/components/SidebarNavReact";
import i18n from "@/i18n";
import ContactForm from "@/components/ContactForm";

import convertAsteriskToStrongTag from "@/utils/convertAsteriskToStrongTag";
import presentation from "@/data/presentation";
import { stackCollections, projectCollections } from "@/data/constants";

const backendStacks = [
  "NodeJS",
  "NestJS",
  "ExpressJS",
  "ASP.NET Core"
];

const languageStacks = [
  "TypeScript",
  "JavaScript",
  "C#"
];

const frontendStacks = [
  "Angular"
];

const databaseStacks = [
  "PostgreSQL",
  "MySQL",
  "MongoDB",
  "SQL Server"
];

const ormStacks = [
  "Prisma",
  "TypeORM"
];

const devopsStacks = [
  "Docker",
  "Docker Compose",
  "Kubernetes"
];

const testingStacks = [
  "Jest"
];

const toolsStacks = [
  "GitHub",
  "Azure DevOps",
  "Postman",
  "DBeaver",
  "Insomnia",
  "Git"
];
---

<Layout>
  <!-- Navegación lateral -->
  <SidebarNavReact client:load />

  <main class="flex flex-col gap-24">

    <!-- ========== PRESENTATION ========== -->
    <article
      id="presentation"
      class="flex flex-col gap-8 md:flex-row-reverse md:justify-end md:gap-12"
    >
      <iframe
        src="/icons/github/github-original.svg"
        class="w-1/4 self-center rounded-full"
        width="200"
        height="200"
      />

      <div class="flex flex-col gap-8">
        <h1 class="text-3xl text-neutral-100" data-i18n="presentationTitle">{presentation.title}</h1>

        <h2
          class="w-auto max-w-[60ch] leading-6 text-neutral-300"
          data-i18n="presentationDescription"
          set:html={convertAsteriskToStrongTag(presentation.description)}
        />

        <SocialLinks />
      </div>
    </article>

    <!-- ========== PROJECTS ========== -->
    <article id="projects" class="flex flex-col gap-8">
      <header>
        <h3 class="text-xl text-neutral-100 font-semibold" data-i18n="projectsTitle">{i18n.t('projectsTitle')} ({projectCollections.length})</h3>
      </header>

      <section class="flex flex-col gap-4 md:flex-row md:flex-wrap">
        {
          projectCollections.map((project) => (
            <ProjectCard
              titleKey={project.titleKey}
              image={project.image}
              descriptionKey={project.descriptionKey}
              techsKey={project.techsKey}
              codeUrl={project.codeUrl}
              demoUrl={project.demoUrl}
              extraLinks={project.extraLinks}
              noteKey={project.noteKey}
            />
          ))
        }
      </section>
    </article>


    <!-- ========== STACKS ========== -->
    <article id="stacks" class="flex flex-col gap-20">

      <!-- BACKEND -->
      <section class="flex flex-col gap-6">
        <h3 class="text-xl text-neutral-100 font-semibold" data-i18n="backend">{i18n.t('backend')}</h3>
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
          {
            stackCollections
              .filter(stack => backendStacks.includes(stack.name))
              .map(stack => (
                <PostCard name={stack.name} image={stack.image} />
              ))
          }
        </div>
      </section>

      <!-- LANGUAGES -->
      <section class="flex flex-col gap-6">
        <h3 class="text-xl text-neutral-100 font-semibold" data-i18n="languages">{i18n.t('languages')}</h3>
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
          {
            stackCollections
              .filter(stack => languageStacks.includes(stack.name))
              .map(stack => (
                <PostCard name={stack.name} image={stack.image} />
              ))
          }
        </div>
      </section>

      <!-- DATABASES -->
      <section class="flex flex-col gap-6">
        <h3 class="text-xl text-neutral-100 font-semibold" data-i18n="databases">{i18n.t('databases')}</h3>
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
          {
            stackCollections
              .filter(stack => databaseStacks.includes(stack.name))
              .map(stack => (
                <PostCard name={stack.name} image={stack.image} />
              ))
          }
        </div>
      </section>

      <!-- DEVOPS -->
      <section class="flex flex-col gap-6">
        <h3 class="text-xl text-neutral-100 font-semibold" data-i18n="devops">{i18n.t('devops')}</h3>
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
          {
            stackCollections
              .filter(stack => devopsStacks.includes(stack.name))
              .map(stack => (
                <PostCard name={stack.name} image={stack.image} />
              ))
          }
        </div>
      </section>

      <!-- FRONTEND -->
      <section class="flex flex-col gap-6">
        <h3 class="text-xl text-neutral-100 font-semibold" data-i18n="frontend">{i18n.t('frontend')}</h3>
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
          {
            stackCollections
              .filter(stack => frontendStacks.includes(stack.name))
              .map(stack => (
                <PostCard name={stack.name} image={stack.image} />
              ))
          }
        </div>
      </section>

      <!-- ORMS -->
      <section class="flex flex-col gap-6">
        <h3 class="text-xl text-neutral-100 font-semibold" data-i18n="orms">{i18n.t('orms')}</h3>
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
          {
            stackCollections
              .filter(stack => ormStacks.includes(stack.name))
              .map(stack => (
                <PostCard name={stack.name} image={stack.image} />
              ))
          }
        </div>
      </section>

      <!-- TESTING -->
      <section class="flex flex-col gap-6">
        <h3 class="text-xl text-neutral-100 font-semibold" data-i18n="testing">{i18n.t('testing')}</h3>
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
          {
            stackCollections
              .filter(stack => testingStacks.includes(stack.name))
              .map(stack => (
                <PostCard name={stack.name} image={stack.image} />
              ))
          }
        </div>
      </section>

      <!-- TOOLS -->
      <section class="flex flex-col gap-6">
        <h3 class="text-xl text-neutral-100 font-semibold" data-i18n="tools">{i18n.t('tools')}</h3>
        <div class="flex flex-col gap-4 md:flex-row md:flex-wrap">
          {
            stackCollections
              .filter(stack => toolsStacks.includes(stack.name))
              .map(stack => (
                <PostCard name={stack.name} image={stack.image} />
              ))
          }
        </div>
      </section>

    </article>





    <!-- ========== CONTACT ========== -->
    <div id="contact" class="flex flex-col md:flex-row gap-12">
      <ContactForm client:load />

      <article class="md:w-1/2 flex flex-col gap-8">
        <h3 class="text-lg text-neutral-100" data-i18n="getInTouch">{i18n.t('getInTouch')}</h3>
        <SocialLinks />
      </article>
    </div>

  </main>
</Layout>
